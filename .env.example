# ---------------------------------------------------------------------------
# AgentPay Sentinel — copy to .env and fill in.
#
# This file is for SECRETS and BEHAVIOUR FLAGS only. The service wiring
# (DATABASE_URL, REDIS_URL, OPA_URL, PROVIDER_URL, CONTROL_PLANE_URL, the key
# paths, ...) is set by docker-compose.yml per container and must NOT live
# here — those values use Docker hostnames like `postgres` and `control-plane`
# that do not resolve when you run `make demo`, `make agent-test`, or
# `scripts/bench.py` locally. Keep .env small.
#
# Keep every value on its own line with NO trailing "# comment" — some parsers
# fold the comment into the value.
# ---------------------------------------------------------------------------

ENVIRONMENT=dev

# --- Groq: powers the LLM half of the prompt-injection classifier and the
# agent simulator's reasoning. Without a key the classifier is unavailable;
# with DEGRADED_CLASSIFIER_REQUIRES_REVIEW=true a clean cart then routes to
# REQUIRE_APPROVAL instead of a hard BLOCK.
# GROQ_MODEL must be a model that supports strict json_schema structured
# outputs — the classifier's response contract depends on it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- classifier behaviour ---
# DEV ONLY — lets a degraded classifier ALLOW. Refuses to start outside dev/test.
ALLOW_DEGRADED_CLASSIFIER=false
# Safe in production, on by default: degraded classifier + clean deterministic
# layers -> REQUIRE_APPROVAL rather than BLOCK.
DEGRADED_CLASSIFIER_REQUIRES_REVIEW=true
# Skip the Groq call entirely (offline demos / CI).
CLASSIFIER_OFFLINE=false

# --- agent simulator ---
# live -> real LLM reasoning (needs a key); offline -> deterministic script.
AGENT_LLM_MODE=live
# CrewAI goes through LiteLLM, so the provider prefix is part of the model id.
AGENT_MODEL=groq/openai/gpt-oss-120b

# --- mock provider demo knob ---
PROVIDER_BEHAVIOUR=success

# --- control plane ---
# Shared secret on every /v1/admin call. Blank => the control plane refuses to
# start outside dev/test. Compose defaults it to dev-admin-key if unset.
ADMIN_API_KEY=dev-admin-key

# --- Telegram bot (DEMO ONLY) — see docs/telegram-integration.md ---
# Get the token from @BotFather. Put the REAL value here in .env (git-ignored),
# never anywhere it can be logged or committed. Revoke + reissue if it leaks.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# polling (laptop demo, no public URL) or webhook (deployed)
TELEGRAM_MODE=polling
