# ---------------------------------------------------------------------------
# AgentPay Sentinel — copy to .env and fill in.
# ---------------------------------------------------------------------------

ENVIRONMENT=dev
POLICY_VERSION=v1.4.2

# --- OpenAI: powers the LLM half of the prompt-injection classifier --------
# The classifier has two deterministic layers besides this (regex rules +
# similarity to known attack patterns). Without a key the LLM layer is
# unavailable and the policy FAILS CLOSED: every transaction is blocked with
# CLASSIFIER_UNAVAILABLE_FAIL_CLOSED unless ALLOW_DEGRADED_CLASSIFIER is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=4

# DEV ONLY — lets the pipeline proceed when the LLM classifier is unavailable,
# so the demos run without an API key. The gateway REFUSES TO START with this
# set unless ENVIRONMENT is dev/test/local. Never set it anywhere real: it
# disables the control that stops an outage from becoming an open door.
ALLOW_DEGRADED_CLASSIFIER=false
# Skip the OpenAI call entirely (offline demos / CI).
CLASSIFIER_OFFLINE=false

# --- dependencies -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://agentpay:agentpay@postgres:5432/agentpay
REDIS_URL=redis://redis:6379/0
OPA_URL=http://opa:8181
PROVIDER_URL=http://provider:9100

# --- identity ---------------------------------------------------------------
JWT_PUBLIC_KEY_PATH=keys/delegation_public.pem
JWT_PRIVATE_KEY_PATH=keys/delegation_private.pem
JWT_ISSUER=agentpay-control-plane
JWT_AUDIENCE=agentpay-sentinel

# --- payment authorization --------------------------------------------------
TOKEN_TTL_SECONDS=300
PROVIDER_TIMEOUT_SECONDS=5
FINGERPRINT_WINDOW_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=86400

# --- mock provider ----------------------------------------------------------
PROVIDER_BEHAVIOUR=success
PROVIDER_TIMEOUT_DELAY=30
